# Environment Configuration Template for SETU
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT SECRETS OR SENSITIVE CREDENTIALS TO SOURCE CONTROL.

# Camera Settings
SETU_CAMERA_INDEX=0
SETU_FRAME_WIDTH=640
SETU_FRAME_HEIGHT=480
SETU_TARGET_FPS=30
SETU_MIRROR_PREVIEW=true

# Vision & Landmark Detection
SETU_MIN_DETECTION_CONFIDENCE=0.50
SETU_MIN_TRACKING_CONFIDENCE=0.50

# Temporal Sequence & Inference Settings
SETU_SEQUENCE_LENGTH=30
SETU_FRAME_STRIDE=2
SETU_CONFIDENCE_THRESHOLD=0.50
