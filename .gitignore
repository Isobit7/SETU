venv.bak/

# Node & Frontend Build Caches
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.vite/
frontend/.vite/

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
build/
dist/

# Logs & Temporary Files
*.log
scratch/
*.tmp
temp/
tmp/
pytest-cache-files-*

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Operating System & IDE Files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

