data/raw/
data/processed/
*.mp4
*.avi
*.mov
*.npy

# Model weights: ignore large reference/pretrained binaries
*.h5
*.keras
*.tflite
*.task
*.onnx
*.pt
*.pth
*.bin
*.weights
models/tasks/*.task
models/reference/*.h5
models/pretrained/*.pth

# Whitelist essential SETU models and configurations
!models/realsign_26class_mlp.pth
